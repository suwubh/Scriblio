# Frontend env — copy to ".env.local" and adjust for your setup.
# These are read by Vite at build time (must be prefixed with VITE_).

# WebRTC signaling server (custom, see signaling-server/)
VITE_SIGNALING_URLS=ws://localhost:4000

# Redis pub/sub WebSocket bridge (see redis-server/)
VITE_REDIS_WS_URL=ws://localhost:8080

# Yjs WebSocket fallback transport
VITE_WEBSOCKET_URL=wss://demos.yjs.dev/ws

# AI proxy endpoint (see server/)
VITE_PROXY_URL=http://localhost:3001/api/chat
