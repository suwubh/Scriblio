# AI proxy env — copy to "server/.env" and fill in your keys.

# At least one provider key is required for the AI palette to work.
OPENAI_API_KEY=your_openai_key_here
GROQ_API_KEY=your_groq_key_here   # optional fallback

PORT=3001

# Comma-separated list of origins allowed to call the proxy.
# Set this to your deployed frontend URL in production.
ALLOWED_ORIGIN=http://localhost:5173
